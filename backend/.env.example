# Backend environment configuration example.
#
# Sprint 2 Week 3 (Varun) — "backend integrity" task: this file did not
# exist at all before. Copy this to .env and fill in real values locally;
# .env itself is gitignored and must never be committed.
#
# IMPORTANT: never put real credentials in this file. If you're sharing
# setup instructions with teammates (Teams, docs, etc.), share this
# redacted file, not your real .env.

PORT=3000
NODE_ENV=development

USER_SERVICE_PORT=50051
NOTIFICATION_SERVICE_PORT=50052
INGESTION_SERVICE_PORT=50053
STORAGE_SERVICE_PORT=50054

USER_SERVICE_URL=localhost:50051
INGESTION_SERVICE_URL=localhost:50053
STORAGE_SERVICE_URL=localhost:50054

USER_PROTO_PATH=/app/dist/libs/proto/user.proto
INGESTION_PROTO_PATH=/app/dist/libs/proto/ingestion.proto
STORAGE_PROTO_PATH=/app/dist/libs/proto/storage.proto

RABBITMQ_URL=amqp://<rabbitmq_user>:<rabbitmq_password>@localhost:5672
RABBITMQ_DEFAULT_USER=<rabbitmq_user>
RABBITMQ_DEFAULT_PASS=<rabbitmq_password>

POSTGRES_HOST=<your_postgres_host>
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=postgres
SUPABASE_CONNECTION_STRING=postgresql://<user>:<url_encoded_password>@<host>:5432/postgres

DEFAULT_TIMEOUT=30000
REDIS_URL=redis://localhost:6379

# Generate real, unique secrets for these — never reuse the values from
# any shared setup guide or teammate's local .env.
AUTH_JWT_SECRET=<generate_a_real_secret>
AUTH_JWT_REFRESH_SECRET=<generate_a_real_secret>

CORE_MODEL_SCRIPT_PATH=libs/common/src/helper/core_model_integration.py
PYTHON_BIN=.venv/bin/python3
SWAGGER_SERVER_URL=http://localhost:3000
