{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/correlation-service",
    "rootDir": ".",
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}