{
  "extends": "../tsconfig.json",

  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "types": [
      "node",
      "jest"
    ],

    "rootDir": ".",
    "outDir": "../dist/user-service",

    "baseUrl": ".",

    "paths": {
      "@phoenix/common": [
        "../libs/common/src/index.ts"
      ],
      "@phoenix/common/*": [
        "../libs/common/src/*"
      ]
    },

    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "noEmit": false,
    "incremental": true
  },

  "include": [
    "src",
    "test"
  ],

  "references": [
    {
      "path": "../libs/common"
    }
  ]
}