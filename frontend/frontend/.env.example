# Browser requests stay on localhost:5173 and are proxied by Vite.
VITE_API_GATEWAY_URL=/

# Actual backend used by the development proxy.
VITE_API_GATEWAY_PROXY_TARGET=http://localhost:3001

# Where the notification panel reads from: "mock" serves records from memory so
# the panel can be run without the gateway; anything else uses the real API.
VITE_NOTIFICATION_PROVIDER=api
